{
  "manifest_version": 3,
  "name": "FormPilot",
  "version": "1.0",
  "description": "Helps you understand confusing form fields.",
  "permissions": ["activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["content.js"]
    }
  ]
}